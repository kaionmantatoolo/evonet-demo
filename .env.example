# Single switch: UAT or PROD. Redeploy after changing (NEXT_PUBLIC_* needs rebuild).
NEXT_PUBLIC_EVONET_TARGET=PROD

# UAT credentials (used when NEXT_PUBLIC_EVONET_TARGET=UAT)
EVONET_UAT_SIGN_KEY=
EVONET_UAT_KEY_ID=
EVONET_UAT_STORE_ID=
# Optional. Defaults to https://sandbox.evonetonline.com/interaction
# EVONET_UAT_INTERACTION_URL=
# Optional. For key-based auth, set to: Key-based
EVONET_UAT_SIGN_TYPE=Key-based

# PROD credentials (used when NEXT_PUBLIC_EVONET_TARGET=PROD)
EVONET_PROD_SIGN_KEY=
EVONET_PROD_KEY_ID=
EVONET_PROD_STORE_ID=
# Optional. Defaults to https://api.evonetonline.com/interaction
# EVONET_PROD_INTERACTION_URL=
EVONET_PROD_SIGN_TYPE=Key-based

# Legacy single-target fallback (used if EVONET_UAT_* / EVONET_PROD_* are unset)
# EVONET_INTERACTION_URL=
# EVONET_SIGN_KEY=
# EVONET_KEY_ID=
# EVONET_STORE_ID=
# EVONET_SIGN_TYPE=Key-based

# Absolute URL Evonet redirects to after wallet / new-tab payments (Alipay, WeChat, …).
# Must match the Drop-in page you start from. Evonet appends ?merchantOrderID=&result=success
EVONET_RETURN_URL=http://localhost:3000/evonet/dropin-test
# EVONET_RETURN_URL=http://localhost:3000/evonet/dropin-builder
# Deployed example: https://<host>/dropin-demo/evonet/dropin-test

# Optional Drop-in environment override (otherwise derived from TARGET: UAT→UAT, PROD→HKG_prod).
# Production-looking values also show live-payment safety notes; UAT / *_test hide those notes.
# NEXT_PUBLIC_EVONET_ENVIRONMENT=HKG_prod
NEXT_PUBLIC_EVONET_DEFAULT_CURRENCY=HKD
NEXT_PUBLIC_EVONET_DROPIN_SCRIPT_URL=https://cdn.jsdelivr.net/npm/cil-dropin-components@latest/dist/index.min.js
